{
  "name": "pingpong-dashboard",
  "version": "1.0.0",
  "description": "Real-time microservices monitoring dashboard",
  "scripts": {
    "dev:auth": "cd services/auth && npm run dev",
    "dev:payment": "cd services/payment && npm run dev",
    "dev:notification": "cd services/notification && npm run dev",
    "dev:all": "concurrently \"npm run dev:auth\" \"npm run dev:payment\" \"npm run dev:notification\"",
    "install:all": "npm run install:auth && npm run install:payment && npm run install:notification",
    "install:auth": "cd services/auth && npm install",
    "install:payment": "cd services/payment && npm install",
    "install:notification": "cd services/notification && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "keywords": ["microservices", "monitoring", "chaos-engineering"],
  "author": "Avinash",
  "license": "MIT"
}